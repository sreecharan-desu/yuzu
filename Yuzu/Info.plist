	<key>NSDocumentsFolderUsageDescription</key>
	<string>Yuzu saves converted copies next to the files you drop in Documents.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Yuzu saves converted copies next to the files you drop in Downloads.</string>
	<key>NSHumanReadableCopyright</key>
	<string>Yuzu. A personal build for Sreecharan. All processing stays on this Mac.</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
